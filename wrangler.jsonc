{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentos-studio-website",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
